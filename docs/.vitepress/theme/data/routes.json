  {
    "id": "mega",
    "title": "超级撒但 · 金门",
    "requirements": [
      "chapter6"
    ],
    "steps": [
      {
        "id": "mega-1",
        "text": "先选择可进入宝箱或暗室的一条分支；还要满足对应照片解锁条件。"
      },
      {
        "id": "mega-2",
        "text": "本局拿齐钥匙碎片 1、2，或准备爸爸的钥匙等开门道具。"
      },
      {
        "id": "mega-3",
        "text": "到宝箱或暗室起始房，打开金门并打败超级撒但。"
      }
    ],
    "note": "钥匙碎片来自炸醒天使雕像后击败天使。Repentance+ 打完会出现去虚空的传送门；不据此保证其他版本的出口。",
    "source": "/guide/unlocks/endings"
  },
  {
    "id": "hush",
    "title": "死寂 · 蓝子宫",
    "requirements": [
      "heart10"
    ],
    "steps": [
      {
        "id": "hush-1",
        "text": "妈妈房后进入子宫。"
      },
      {
        "id": "hush-2",
        "text": "本局 30 分钟内打败妈妈的心脏 / 它活着，立即进入蓝子宫。"
      },
      {
        "id": "hush-3",
        "text": "打败死寂。"
      }
    ],
    "note": "超过 30 分钟后离开再回来，蓝子宫入口会消失。",
    "source": "/guide/unlocks/endings"
  },
  {
    "id": "delirium",
    "title": "精神错乱 · 虚空",
    "requirements": [
      "hush1"
    ],
    "steps": [
      {
        "id": "delirium-1",
        "text": "准备进入虚空：可规划再次打死寂，或寻找其他 Boss 后的传送门。"
      },
      {
        "id": "delirium-2",
        "text": "发现虚空传送门后进入；进入会转去虚空路线。"
      },
      {
        "id": "delirium-3",
        "text": "探索多个 Boss 房，找到并打败精神错乱。"
      }
    ],
    "note": "攻略的死寂出口版本描述有待核实，工具不保证首次死寂后的出口。Repentance+ 打完 ???、羔羊、超级撒但、母亲也必定出现入口；其他版本与 Boss 不作必出承诺。",
    "source": "/guide/unlocks/endings"
  },
  {
    "id": "mother",
    "title": "母亲 · 尸宫",
    "requirements": [
      "hush3"
    ],
    "steps": [
      {
        "id": "mother-1",
        "text": "地下室章 Boss 后用 1 把钥匙进入下水道分支。"
      },
      {
        "id": "mother-2",
        "text": "下水道 II 碰白火变幽灵，穿镜子去镜像宝箱房拿菜刀碎片 1。"
      },
      {
        "id": "mother-3",
        "text": "用 2 个炸弹打开矿洞入口，前往矿洞 II。"
      },
      {
        "id": "mother-4",
        "text": "矿洞 II 按三个黄色按钮，坐矿车拿菜刀碎片 2，逃回入口。"
      },
      {
        "id": "mother-5",
        "text": "深处 I 或矿洞 II Boss 后进入陵墓，开门扣 2 颗完整的心。"
      },
      {
        "id": "mother-6",
        "text": "陵墓 II 打败加强版妈妈，用完整菜刀刺开肉门，打败门后的心脏。"
      },
      {
        "id": "mother-7",
        "text": "进入尸宫，前往尸宫 II 并打败母亲。"
      }
    ],
    "note": "没有碎片 1，碎片 2 的房间不会生成。尸宫伤害按整颗心扣。特殊角色的门费处理请另查角色攻略，工具不自动判定是否能存活。",
    "source": "/guide/unlocks/endings"
  },
  {
    "id": "beast",
    "title": "祸兽 · 回家",
    "requirements": [
      "mother1"
    ],
    "steps": [
      {
        "id": "beast-1",
        "text": "深处 II 留好传送手段：炸特殊头骨拿 0-愚者最稳。"
      },
      {
        "id": "beast-2",
        "text": "打败妈妈拿全家福或底片，用传送回到起始房。"
      },
      {
        "id": "beast-3",
        "text": "用照片打开奇怪的门；照片会被消耗。"
      },
      {
        "id": "beast-4",
        "text": "门后的特殊陵墓 II 捡起爸爸的便条，开始上行。"
      },
      {
        "id": "beast-5",
        "text": "每层从 Boss 房走到起始房找光柱，返回地下室 I，再进家。"
      },
      {
        "id": "beast-6",
        "text": "在家依次打败 Dogma、强化四骑士与祸兽。"
      }
    ],
    "note": "上行途中受伤按整颗心扣。第一次到家，妈妈卧室箱子必给红钥匙，可顺路解锁里角色。",
    "source": "/guide/unlocks/endings"
  },
